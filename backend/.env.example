# Copy to backend/.env for local development. Do not commit real values.

HERMES_CONSOLE_APP_NAME=Hermes Bots Manager
HERMES_CONSOLE_DEBUG=false
HERMES_CONSOLE_DATABASE_URL=sqlite+aiosqlite:///./hermes_console.db

# Use a unique random value with at least 32 characters outside local dev.
HERMES_CONSOLE_JWT_SECRET=replace-with-a-random-32-character-secret

# Fernet master key path. The app creates the key file with mode 0600.
HERMES_CONSOLE_MASTER_KEY_PATH=~/.hermes-console/master.key

# Hermes CLI profile root. Named bot profiles live under profiles/<bot-name>.
HERMES_CONSOLE_HERMES_HOME=~/.hermes

# Deleted bot archives are stored here.
HERMES_CONSOLE_ARCHIVE_DIR=~/.hermes-console/archives

# Optional production WebSocket Origin allowlist, JSON list syntax.
# HERMES_CONSOLE_WS_ALLOWED_ORIGINS=["https://console.example.com"]
